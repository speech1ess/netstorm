[Unit]
Description=NUMA-Aware 1GB HugePages Allocation for TRex
# Стартуем как можно раньше, до того как другие процессы фрагментируют память
DefaultDependencies=no
After=sysinit.target local-fs.target
Before=basic.target

[Service]
Type=oneshot
# Игнорируем ошибки при обнулении (знак минус перед командой), если 2MB страницы отключены в ядре
ExecStart=-/bin/bash -c 'echo 0 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages'

# Строго аллоцируем 48 страниц (48 ГБ) на NUMA 0 (socket 0) для TRex
ExecStart=/bin/bash -c 'echo 48 > /sys/devices/system/node/node0/hugepages/hugepages-1048576kB/nr_hugepages'

# (Опционально) Если тебе нужны HugePages на NUMA 1 для других задач, раскомментируй и поправь значение
# ExecStart=/bin/bash -c 'echo 16 > /sys/devices/system/node/node1/hugepages/hugepages-1048576kB/nr_hugepages'

RemainAfterExit=yes

[Install]
WantedBy=basic.target
