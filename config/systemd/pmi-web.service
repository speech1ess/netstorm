[Unit]
Description=PMI Web Orchestrator
After=network.target nginx.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pmi/web
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
Environment="PYTHONPATH=/opt/pmi/lib"
Environment="PYTHONUNBUFFERED=1"
Environment="PMI_WEB_MODE=1"

[Install]
WantedBy=multi-user.target
